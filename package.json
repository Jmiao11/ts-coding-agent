{
  "name": "ts-coding-agent",
  "version": "0.2.0-beta.0",
  "description": "A lightweight TypeScript coding agent runtime with tool calling, context compaction, persistent sessions, and file undo.",
  "author": "Jmiao11",
  "license": "MIT",
  "keywords": [
    "coding-agent",
    "agent-runtime",
    "typescript",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ts-coding-agent": "dist/cli.js"
  },

  "files": [
    "dist",
    "!dist/examples",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],

  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm clean && pnpm build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/client": "2.3.1",
    "typebox": "^1.3.34"
  },
  "optionalDependencies": {
    "@microsoft/mxc-sdk": "1.0.0"
  }
}
